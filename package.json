{
  "name": "tradecheck-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @tradecheck/gateway --filter @tradecheck/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "check": "pnpm build && pnpm test && pnpm -r --if-present typecheck",
    "upstream:status": "node scripts/upstream-status.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
